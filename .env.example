# Másold le .env.local néven, és töltsd ki. A .env.local soha nem kerül gitbe.
# Értékek: Supabase Dashboard → Project Settings → API (Keys)

# Nyilvános (a böngészőbe is eljut, ez így rendben van – a védelem az RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # vagy a régi "anon" kulcs

# TITKOS – csak szerveroldalon használható, soha ne legyen NEXT_PUBLIC_ előtagja
SUPABASE_SECRET_KEY=sb_secret_...                          # vagy a régi "service_role" kulcs
