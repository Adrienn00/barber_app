# Másold le .env.local néven, és töltsd ki. A .env.local soha nem kerül gitbe.
# Értékek: Supabase Dashboard → Project Settings → API (Keys)

# Nyilvános (a böngészőbe is eljut, ez így rendben van – a védelem az RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # vagy a régi "anon" kulcs

# TITKOS – csak szerveroldalon használható, soha ne legyen NEXT_PUBLIC_ előtagja
SUPABASE_SECRET_KEY=sb_secret_...                          # vagy a régi "service_role" kulcs

# Push-értesítések – helyben: npm run notifications:setup (kulcsokat generál), majd npm run db:config
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...                           # nyilvános VAPID kulcs
VAPID_PRIVATE_KEY=...                                      # TITKOS
VAPID_SUBJECT=mailto:ertesites@chairtime.local             # élesítéskor: a saját domain e-mail címe
NOTIFY_DISPATCH_SECRET=...                                 # TITKOS – az adatbázis ezzel hívja a küldőt
NOTIFY_DISPATCH_URL=http://host.docker.internal:3000/api/notifications/dispatch   # élesben: https://<domain>/api/notifications/dispatch

# E-mail csatorna – helyben kikapcsolva; élesben: docs/elesites.md
EMAIL_ENABLED=false
# EMAIL_PROVIDER=brevo                                     # brevo (domain nélkül is) vagy resend (saját domainnel)
# BREVO_API_KEY=...                                        # TITKOS
# RESEND_API_KEY=...                                       # TITKOS (csak resend esetén)
# EMAIL_FROM=ChairTime <chairtime.ertesites@gmail.com>     # a szolgáltatónál igazolt feladó
# APP_URL=https://chairtime.vercel.app                     # a levelekben lévő linkekhez
